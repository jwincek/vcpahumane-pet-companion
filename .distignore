# Files left out of the release zip by bin/build-dist.sh. They live in the
# repository for development and are of no use on a partner's site.

.git
.github
.gitignore
.distignore
.DS_Store
**/.DS_Store
# The whole vendor tree: the plugin has no runtime dependencies, so anything
# Composer installs here is PHPCS or PHPUnit. CI runs composer install, so a
# narrower rule would ship them from there.
vendor
composer.json
composer.lock
phpcs.xml.dist
phpunit.xml.dist
.phpunit.result.cache
tests
bin
node_modules
# Generated by bin/build-dist.sh. Excluded, or the build nests a copy of itself.
build

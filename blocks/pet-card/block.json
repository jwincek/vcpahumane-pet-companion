{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vcpa-pet-companion/pet-card",
	"title": "VCPA Pet Card",
	"category": "widgets",
	"icon": "heart",
	"description": "Embed a single adoptable pet by ID or slug.",
	"keywords": [ "pet", "adopt", "vchs", "vcpa" ],
	"textdomain": "vcpahumane-pet-companion",
	"supports": {
		"html": false,
		"align": [ "wide" ],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true
			}
		}
	},
	"attributes": {
		"petId":         { "type": "number", "default": 0 },
		"petSlug":       { "type": "string", "default": "" },
		"petName":       { "type": "string", "default": "" },
		"petImage":      { "type": "string", "default": "" },
		"petAlt":        { "type": "string", "default": "" },
		"imagePosition": { "type": "string", "default": "left", "enum": [ "left", "top" ] },
		"showFullStory": { "type": "boolean", "default": true }
	},
	"example": { "attributes": { "petId": 0 } },
	"render": "file:./render.php",
	"editorScript": "file:./edit.js",
	"style": "vcpa-pet-companion"
}

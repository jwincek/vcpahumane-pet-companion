{
    "name": "jwincek/vcpahumane-pet-companion",
    "description": "Display adoptable pets from the Venango County Humane Society on partner WordPress sites.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit",
        "check:versions": "php bin/check-versions.php"
    }
}

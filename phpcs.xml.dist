<?xml version="1.0"?>
<ruleset name="VCPA Humane Pet Companion">
	<description>Security, i18n and PHP-compatibility checks. Deliberately not the
	full WordPress style standard: restyling every file would change nothing
	partners see, while these sniffs catch what reaches them.</description>

	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<exclude-pattern>/vendor/*</exclude-pattern>

	<!-- PHP 8.1 is the floor in the plugin header. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_supported_wp_version" value="6.4"/>

	<!-- Escaping, nonces, input sanitizing. The plugin prints HTML built from
	     another site's REST responses, so these are the sniffs that matter. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.Security.EscapeOutput">
		<!-- Command-line tools print to a terminal, not a page. -->
		<exclude-pattern>/bin/*</exclude-pattern>
		<properties>
			<!-- Each returns markup it has already escaped. get_block_wrapper_attributes()
			     is core's; the other two are this plugin's, covered by the tests. -->
			<property name="customAutoEscapedFunctions" type="array">
				<element value="get_block_wrapper_attributes"/>
				<element value="vcpa_pet_companion_render_card"/>
				<element value="vcpa_pet_companion_render_empty"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="vcpahumane-pet-companion"/>
			</property>
		</properties>
	</rule>
</ruleset>
